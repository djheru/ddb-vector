meta {
  name: Search Recipes
  type: graphql
  seq: 4
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

headers {
  x-api-key: {{graphqlApiKey}}
}

body:graphql {
  query SearchRecipes($query: String!) {
    searchRecipes(query: $query) {
      query
      results {
        recipeId
        name
        cuisine
        similarity
        distance
      }
      nextCursor
    }
  }
}

body:graphql:vars {
  {
    "query": "spicy mexican chicken stew fiery chipotle"
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
}

tests {
  test("results is an array", function () {
    expect(res.getBody().data.searchRecipes.results).to.be.an("array");
  });

  test("results are sorted by similarity descending", function () {
    const results = res.getBody().data.searchRecipes.results;
    for (let i = 1; i < results.length; i++) {
      expect(results[i - 1].similarity).to.be.at.least(results[i].similarity);
    }
  });
}
