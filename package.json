{
  "name": "recipe-catalog-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy:pipeline": "cdk deploy RecipecatalogPipeline",
    "deploy:sandbox": "cdk deploy \"Sandbox-$USER/*\" -c sandbox=$USER",
    "destroy:sandbox": "cdk destroy \"Sandbox-$USER/*\" -c sandbox=$USER",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1116.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/util-dynamodb": "^3.996.9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "^2.266.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}